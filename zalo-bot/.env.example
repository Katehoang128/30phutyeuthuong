# Name of the virtual assistant that customers see in chat (example: Mai, Bếp Trưởng An...).
BOT_NAME=Mai

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to the same model the web app's api-server uses.
GEMINI_MODEL=gemini-3.6-flash

# Zalo Bot Token: in the Zalo app, find "Zalo Bot Manager", create a bot, and the token is sent to you by message.
ZALO_BOT_TOKEN=
# Any random string of 8-256 characters that you invent. The service registers it with Zalo as the webhook secret.
ZALO_WEBHOOK_SECRET=
# Only needed off Render (Render fills RENDER_EXTERNAL_URL itself): the public https URL of this service, no trailing slash.
# PUBLIC_URL=https://your-service.onrender.com
# Only change if Zalo moves its Bot API host.
# ZALO_BOT_API_BASE=https://bot-api.zapps.me
