# Name of the virtual assistant that customers see in chat (example: Mai, Bếp Trưởng An...).
BOT_NAME=Mai

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to the same model the web app's api-server uses.
GEMINI_MODEL=gemini-3.6-flash

# Zalo Official Account access token (developers.zalo.me -> your app -> Official Account -> API Explorer / OAuth).
# It expires (about 25 hours); refresh it with your refresh_token and update this value.
ZALO_ACCESS_TOKEN=

# Optional but recommended: turns on webhook signature checking.
# ZALO_APP_ID is the Zalo app ID; ZALO_OA_SECRET_KEY is the OA secret key of that app.
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
